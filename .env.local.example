# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Push notifications (Web Push / VAPID keys).
# A ready-to-use pair is provided in the README so you can get started
# immediately, but you can generate your own any time — see README.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identifies who's sending the push messages, per the Web Push spec.
# A mailto address is fine and doesn't need to be a real inbox.
VAPID_SUBJECT=mailto:admin@example.com

# Telegram notifications (optional). Every status change, and every app
# added/removed, gets posted to this chat. See README for how to get
# these two values from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram bot COMMANDS (optional) — lets teammates type "status" /
# "problems" in the chat and get a live reply. Requires the service role
# key (Supabase Settings -> API -> service_role — keep this SECRET,
# never put it in a NEXT_PUBLIC_ variable) and a one-time webhook setup,
# see README.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_WEBHOOK_SECRET=
# Optional: comma-separated chat IDs allowed to query the bot, in
# addition to TELEGRAM_CHAT_ID above (e.g. teammates' personal DMs with
# the bot). Leave blank to only allow the main TELEGRAM_CHAT_ID chat.
TELEGRAM_ALLOWED_CHAT_IDS=

# Your bot's public @username (no @ symbol), e.g. "app_status_alerts_bot".
# Shown as a scannable QR code + link in the app so teammates can find
# and open your bot in one tap, instead of searching for it manually.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
